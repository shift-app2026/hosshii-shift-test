  "➄.csv": [
    {
      "function_schema": "public",
      "function_name": "generate_application_code",
      "arguments": "",
      "language": "sql",
      "security_definer": "false",
      "function_settings": "[\"search_path=\\\"\\\"\"]",
      "review_status": "定義表示",
      "definition": "CREATE OR REPLACE FUNCTION public.generate_application_code()\n RETURNS text\n LANGUAGE sql\n SET search_path TO ''\nAS $function$\r\n  SELECT upper(encode(extensions.gen_random_bytes(12), 'hex'));\r\n$function$\n"
    },
    {
      "function_schema": "public",
      "function_name": "prevent_trial_start_change",
      "arguments": "",
      "language": "plpgsql",
      "security_definer": "false",
      "function_settings": "null",
      "review_status": "定義表示",
      "definition": "CREATE OR REPLACE FUNCTION public.prevent_trial_start_change()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nBEGIN\r\n  IF OLD.trial_started_at IS NOT NULL\r\n     AND NEW.trial_started_at IS DISTINCT FROM OLD.trial_started_at THEN\r\n    RAISE EXCEPTION 'Trial start date cannot be changed';\r\n  END IF;\r\n\r\n  RETURN NEW;\r\nEND;\r\n$function$\n"
    },
    {
      "function_schema": "public",
      "function_name": "set_trial_end_date",
      "arguments": "",
      "language": "plpgsql",
      "security_definer": "false",
      "function_settings": "[\"search_path=\\\"\\\"\"]",
      "review_status": "定義表示",
      "definition": "CREATE OR REPLACE FUNCTION public.set_trial_end_date()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\r\nBEGIN\r\n  IF NEW.trial_started_at IS NOT NULL THEN\r\n    NEW.trial_ends_at := NEW.trial_started_at + INTERVAL '21 days';\r\n  END IF;\r\n\r\n  RETURN NEW;\r\nEND;\r\n$function$\n"
    }
  ],
